rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.get('role', '') == 'superadmin';
    }

    function isAllowedSignupRole() {
      return request.resource.data.role in [
        'parent', 'adult_player', 'youth_player', 'coach', 'admin', 'league_creator'
      ];
    }

    function isSafeSelfUserCreate(userId) {
      return request.resource.data.id == userId &&
        isAllowedSignupRole() &&
        !request.resource.data.keys().hasAny([
          'plan_type', 'team_limit', 'extra_teams', 'subscription_status',
          'stripe_customer_id', 'stripe_subscription_id',
          'isPrimaryClubAuthority', 'isBetaTester'
        ]) &&
        request.resource.data.get('activePlanId', 'starter_squad') in ['starter_squad', null] &&
        request.resource.data.get('proTeamLimit', 0) == 0;
    }

    function isSafeSelfUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'fullName', 'email', 'phone', 'avatar', 'avatarUrl',
        'notificationsEnabled', 'schoolName', 'institutionTitle',
        'clubName', 'clubDescription', 'seenAlertIds',
        'lastAlertArchivedAt', 'lastBulkArchiveAt'
      ]);
    }

    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.get('status', 'active') != 'removed' &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.get('isDeleted', false) != true;
    }

    function isTeamOwner(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUserId == request.auth.uid;
    }

    function isDemoOwner(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.get('demoOwnerUserId', '') == request.auth.uid;
    }

    function isTeamStaff(teamId) {
      return isTeamOwner(teamId) || (isTeamMember(teamId) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.get('role', '') == 'Admin' ||
          get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.get('position', '') in [
            'Coach', 'Head Coach', 'Assistant Coach', 'Manager',
            'Squad Leader', 'Athletic Director', 'Staff'
          ]
        ));
    }

    function isTeamCoachOfPlayer(playerId) {
      let playerData = get(/databases/$(database)/documents/players/$(playerId)).data;
      // Support both 'teamId' (legacy single) and 'primaryTeamId' (current scalar field)
      let tId = playerData.get('primaryTeamId', playerData.get('teamId', ''));
      return isSignedIn() &&
        exists(/databases/$(database)/documents/players/$(playerId)) &&
        tId != '' &&
        exists(/databases/$(database)/documents/teams/$(tId)) &&
        get(/databases/$(database)/documents/teams/$(tId)).data.ownerUserId == request.auth.uid;
    }

    function canReadPlayer(playerId) {
      return isSignedIn() && exists(/databases/$(database)/documents/players/$(playerId)) && (
        get(/databases/$(database)/documents/players/$(playerId)).data.get('demoOwnerUserId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/players/$(playerId)).data.get('parentId', '') == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/players/$(playerId)).data.get('guardianIds', []) ||
        isTeamCoachOfPlayer(playerId)
      );
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      // Demo seeder creates mock child/teen user profiles (alexId, juniorId) with isDemo:true.
      // These are NOT the authenticated user, so we allow create for demo docs specifically.
      // Scope: signed-in only, isDemo:true must be in the written doc, no other bypass.
      allow create: if isSuperAdmin() || (isSignedIn() && (
        (isOwner(userId) && isSafeSelfUserCreate(userId)) ||
        (request.resource.data.get('isDemo', false) == true &&
         request.resource.data.get('demoOwnerUserId', '') == request.auth.uid)
      ));
      allow update: if isSuperAdmin() || (isSignedIn() && (
        (isOwner(userId) && isSafeSelfUserUpdate()) ||
        (resource.data.get('isDemo', false) == true &&
         resource.data.get('demoOwnerUserId', '') == request.auth.uid)
      ));
      allow delete: if false;

      match /tokens/{tokenId} {
        allow read, write: if false;
      }

      match /teamMemberships/{teamId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow write: if isSignedIn() && isOwner(userId);
      }

      match /clubDocuments/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
        allow write: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      }

      match /{subCollection}/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
        allow write: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      }
    }

    // ─── Teams ──────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource == null ||
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.get('demoOwnerUserId', '') == request.auth.uid ||
        isTeamMember(teamId)
      ));
      allow create: if isSuperAdmin() || (isSignedIn() && (
        request.resource.data.ownerUserId == request.auth.uid ||
        (request.resource.data.get('isDemo', false) == true &&
         request.resource.data.get('demoOwnerUserId', '') == request.auth.uid)
      ));
      // Only team owner can update or delete the team document itself
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource != null && (
          resource.data.ownerUserId == request.auth.uid ||
          resource.data.get('demoOwnerUserId', '') == request.auth.uid
        )
      ));
      allow delete: if isSuperAdmin() || (isSignedIn() && resource != null && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.get('demoOwnerUserId', '') == request.auth.uid
      ));

      match /members/{memberId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (
          resource == null ||
          resource.data.ownerUserId == request.auth.uid ||
          isTeamOwner(teamId) ||
          isTeamMember(teamId) ||
          isDemoOwner(teamId)
        ));
        allow create: if isSuperAdmin() || (isSignedIn() && (
          isTeamOwner(teamId) ||
          isDemoOwner(teamId) ||
          (existsAfter(/databases/$(database)/documents/teams/$(teamId)) &&
           getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid)
        ));
        allow update, delete: if isSuperAdmin() || (isSignedIn() && (
          isTeamOwner(teamId) ||
          isDemoOwner(teamId)
        ));

        match /signatures/{sigId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && (
            isTeamOwner(teamId) ||
            (isTeamMember(teamId) && request.auth.uid == memberId)
          ));
        }

        // Catch-all for member subcollections (staffEvaluation, notes, etc.)
        // The explicit match /members/{memberId} block takes priority over the outer team
        // catch-all, so any member sub-subcollections need their own catch-all here.
        match /{subCollection}/{docId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        }
      }

      match /events/{eventId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));

        match /brackets/{bracketId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        }
      }

      match /incidents/{incidentId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      match /games/{gameId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      match /fundraising/{fundId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow create, delete: if isSuperAdmin() || isTeamStaff(teamId);
        allow update: if isSuperAdmin() || isTeamStaff(teamId) ||
          (isTeamMember(teamId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finances']) &&
           request.resource.data.get('finances', {}).diff(resource.data.get('finances', {})).affectedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.finances[request.auth.uid].userId == request.auth.uid);

        match /donations/{donationId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || isTeamStaff(teamId);
        }
      }

      // ─── Online Payment Items (coaches create payable line items) ──────────
      match /paymentItems/{itemId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      // ─── Payments (online + offline payment records) ────────────────────────
      // Server-side (webhook, Admin SDK) writes bypass these rules.
      // Coaches (team owners) can write offline records.
      // All team members can read payment records.
      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      // ─── Coach Waiver Signatures (hub-deployed global waivers for staff) ────
      // Any team member (coach, assistant, staff) can write their own signature.
      // Only the team owner can read all signatures for compliance auditing.
      match /coachWaiverSignatures/{waiverDocId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        // A member can create/update only their OWN signature record
        allow write: if isSuperAdmin() || (isSignedIn() && (
          isTeamMember(teamId) &&
          request.resource.data.signedBy == request.auth.uid
        ) || isTeamOwner(teamId));
      }

      match /groupChats/{chatId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow create: if isSuperAdmin() || (isTeamMember(teamId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.auth.uid in request.resource.data.memberIds);
        allow update, delete: if isSuperAdmin() || isTeamStaff(teamId) ||
          (isTeamMember(teamId) && resource.data.createdBy == request.auth.uid);

        match /messages/{messageId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow create: if isTeamMember(teamId) &&
            request.resource.data.authorId == request.auth.uid;
          allow update: if isTeamStaff(teamId) || (isTeamMember(teamId) && (
            resource.data.authorId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
          ));
          allow delete: if isTeamStaff(teamId) ||
            (isTeamMember(teamId) && resource.data.authorId == request.auth.uid);
        }
      }

      match /volunteers/{opportunityId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow create, delete: if isSuperAdmin() || isTeamStaff(teamId);
        allow update: if isSuperAdmin() || isTeamStaff(teamId) ||
          (isTeamMember(teamId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups']) &&
           request.resource.data.get('signups', {}).diff(resource.data.get('signups', {})).affectedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.signups[request.auth.uid].userId == request.auth.uid &&
           request.resource.data.signups[request.auth.uid].status == 'pending' &&
           request.resource.data.signups[request.auth.uid].get('isConfirmed', false) == false);
      }

      match /{subCollection}/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && (
          isTeamOwner(teamId) ||
          isDemoOwner(teamId)
        ));

        match /{subSubCollection}/{subDocId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && (
            isTeamOwner(teamId) ||
            isDemoOwner(teamId)
          ));
        }
      }
    }

    // ─── Players ────────────────────────────────────────────────────────────
    match /players/{playerId} {
      // Public recruiting pages use the sanitized server DTO. Raw player records
      // may contain guardian, login, and household linkage data.
      allow read: if canReadPlayer(playerId);

      // Demo seeder creates fake child player profiles (juniorId, alexId) with isDemo:true.
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('parentId', '') == request.auth.uid ||
        (request.resource.data.get('isDemo', false) == true &&
         request.resource.data.get('demoOwnerUserId', '') == request.auth.uid)
      );

      // Coaches can update top-level player doc (e.g. toggleRecruitingProfile).
      // They include updatedByTeamId in the written data so we can verify ownership.
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('parentId', '') == request.auth.uid ||
        playerId == request.auth.uid ||
        isTeamCoachOfPlayer(playerId) ||
        resource.data.get('demoOwnerUserId', '') == request.auth.uid ||
        (request.resource.data.get('updatedByTeamId', '') != '' &&
         exists(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)) &&
         get(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)).data.ownerUserId == request.auth.uid)
      ));

      allow delete: if isSuperAdmin() || (isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('demoOwnerUserId', '') == request.auth.uid
      ));

      match /{subCollection}/{docId} {
        allow read: if canReadPlayer(playerId);

        // ── CREATE / UPDATE ──────────────────────────────────────────────────
        // request.resource.data is available for create and update.
        // Coaches include updatedByTeamId in written data; rule verifies ownership.
        allow create, update: if isSuperAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
          isTeamCoachOfPlayer(playerId) ||
          get(/databases/$(database)/documents/players/$(playerId)).data.get('demoOwnerUserId', '') == request.auth.uid ||
          playerId == request.auth.uid ||
          (request.resource.data.get('updatedByTeamId', '') != '' &&
           exists(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)) &&
           get(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)).data.ownerUserId == request.auth.uid)
        ));

        // ── DELETE ───────────────────────────────────────────────────────────
        // request.resource is NULL for deletes — use resource.data (the existing doc).
        // If updatedByTeamId was set when the doc was last written, use it.
        // Otherwise fall back to player-self or coach checks.
        allow delete: if isSuperAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
          isTeamCoachOfPlayer(playerId) ||
          get(/databases/$(database)/documents/players/$(playerId)).data.get('demoOwnerUserId', '') == request.auth.uid ||
          playerId == request.auth.uid ||
          (resource.data.get('updatedByTeamId', '') != '' &&
           exists(/databases/$(database)/documents/teams/$(resource.data.updatedByTeamId)) &&
           get(/databases/$(database)/documents/teams/$(resource.data.updatedByTeamId)).data.ownerUserId == request.auth.uid)
        ));
      }
    }

    // ─── Leagues ────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      );

      match /registrationEntries/{entryId} {
        // Public submissions go through the validated server endpoint. Direct
        // client writes are reserved for the league creator's manual enrollment.
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid;
        allow read: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid;
      }

      match /archived_waivers/{waiverId} {
        allow read, write: if isSignedIn() && 
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid;
      }

      match /registration/{configId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid;
      }

      match /scores/{scoreId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /divisions/{divisionId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);

        match /{subCollection}/{docId} {
          allow read: if isSignedIn();
          allow write: if isSuperAdmin() || (isSignedIn() &&
            get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);

          match /{deepCollection}/{deepDocId} {
            allow read: if isSignedIn();
            allow write: if isSuperAdmin() || (isSignedIn() &&
              get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
          }
        }
      }
    }

    // ─── Leagues global invites ───────────────────────────────────────────────
    // FIX #5: write restricted to superadmin only (was isSignedIn())
    match /leagues/global/invites/{inviteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Tournament Hubs ─────────────────────────────────────────────────────
    match /tournaments/{hubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      );

      match /divisions/{divisionId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);

        match /{subCollection}/{docId} {
          allow read: if isSignedIn();
          allow write: if isSuperAdmin() || (isSignedIn() &&
            get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);

          match /{deepCollection}/{deepDocId} {
            allow read: if isSignedIn();
            allow write: if isSuperAdmin() || (isSignedIn() &&
              get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);
          }
        }
      }
    }

    // ─── Plans ──────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── Subscriptions ───────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ─── Calendar feeds ──────────────────────────────────────────────────────
    match /calendarFeeds/{feedId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Volunteers ──────────────────────────────────────────────────────────
    match /volunteerOpportunities/{oppId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();

      match /signups/{signupId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // ─── Signatures ──────────────────────────────────────────────────────────
    match /signatures/{sigId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Alerts ──────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || (
        isSignedIn() && (
          request.resource.data.createdBy == request.auth.uid &&
          (
            request.resource.data.teamId == null ||
            isTeamMember(request.resource.data.teamId) ||
            isTeamOwner(request.resource.data.teamId)
          )
        )
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.createdBy == request.auth.uid
      );
    }

    // ─── Facilities ───────────────────────────────────────────────────────────
    match /facilities/{facilityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.clubId == request.auth.uid;
      allow update, delete: if isSuperAdmin() ||
        (isSignedIn() && resource.data.clubId == request.auth.uid);

      match /{subCollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/facilities/$(facilityId)).data.clubId == request.auth.uid);
      }
    }


    // ─── Features ────────────────────────────────────────────────────────────
    match /features/{featureId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── Clubs ───────────────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /{subCollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }
    }

    // ─── Invites ─────────────────────────────────────────────────────────────
    // FIX #4: update requires auth (was `if true` — public unauthenticated token replay)
    match /invites/{inviteId} {
      // Youth invite tokens are handled by the authenticated API, which checks
      // guardian ownership and atomically consumes each token once.
      allow read, create, update, delete: if false;
    }

    // ─── Beta Tester System ──────────────────────────────────────────────────
    match /beta_applications/{appId} {
      // Public submissions are written by the server API using Admin SDK.
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }

    match /bug_reports/{bugId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /beta_notifications/{notifId} {
      allow create, update, delete: if isSuperAdmin();
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBetaTester == true
      );
    }

    // ─── CollectionGroup Rules ───────────────────────────────────────────────
    match /{path=**}/members/{memberId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.parentId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.schoolId != null && (isTeamMember(resource.data.schoolId) || isTeamOwner(resource.data.schoolId)))
      ));
    }

    match /{path=**}/events/{eventId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.isTournament == true ||
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.teamId != null && (
          isTeamMember(resource.data.teamId) ||
          isTeamOwner(resource.data.teamId)
        ))
      ));
    }

    match /{path=**}/signatures/{sigId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.teamId != null && (isTeamOwner(resource.data.teamId) || isTeamMember(resource.data.teamId)))
      ));
    }

    match /{path=**}/documents/{docId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /{path=**}/incidents/{incidentId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /{path=**}/registrationEntries/{entryId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.assigned_team_owner_id == request.auth.uid ||
        (resource.data.league_id != null && get(/databases/$(database)/documents/leagues/$(resource.data.league_id)).data.creatorId == request.auth.uid)
      ));
    }

    // ─── Newsletter signups ───────────────────────────────────────────────────
    match /newsletter_signups/{docId} {
      // Public submissions are written by the server API using Admin SDK.
      allow create: if false;
      allow read, delete: if isSuperAdmin();
    }

    // ─── Sports Hub administration ────────────────────────────────────────────
    match /sports_hub_rss_feeds/{feedId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /sports_hub_articles/{articleId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /sports_hub_newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if false;
    }

    // ─── Contact Inquiries (enterprise contact form) ──────────────────────────
    // Public submissions are written by the server API using Admin SDK.
    // Superadmin only read/delete: protects PII (name, email, inquiry text).
    match /contact_inquiries/{docId} {
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
