rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymousSession() {
      return isAuthenticated() &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    function isSignedIn() {
      let user = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
      return isAuthenticated() && (
        isAnonymousSession() ||
        (
          (
            request.auth.token.get('email_verified', false) == true ||
            request.auth.token.get('role', '') == 'superadmin'
          ) &&
          user.data.get('accountStatus', 'active') != 'suspended' &&
          user.data.get('accountStatus', 'active') != 'pending_deletion' &&
          user.data.get('deletionStatus', '') != 'pending'
        )
      );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.get('role', '') == 'superadmin';
    }

    function playerDocument(playerId) {
      return firestore.get(/databases/(default)/documents/players/$(playerId));
    }

    function isPrimaryTeamOwner(playerId) {
      let player = playerDocument(playerId);
      return isSignedIn() && (
        (
          player.data.keys().hasAny(['primaryTeamId']) &&
          player.data.primaryTeamId != '' &&
          firestore.get(/databases/(default)/documents/teams/$(player.data.primaryTeamId))
            .data.ownerUserId == request.auth.uid
        ) ||
        (
          player.data.keys().hasAny(['teamId']) &&
          player.data.teamId != '' &&
          firestore.get(/databases/(default)/documents/teams/$(player.data.teamId))
            .data.ownerUserId == request.auth.uid
        )
      );
    }

    function canManagePlayer(playerId) {
      let player = playerDocument(playerId);
      return isSuperAdmin() || (isSignedIn() && (
        (
          player.data.keys().hasAny(['userId']) &&
          player.data.userId == request.auth.uid
        ) ||
        (
          player.data.keys().hasAny(['parentId']) &&
          player.data.parentId == request.auth.uid
        ) ||
        isPrimaryTeamOwner(playerId)
      ));
    }

    function hasSafeImageUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function hasSafeVideoUpload() {
      return request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/(mp4|webm|quicktime|x-m4v)');
    }

    // Recruiting media is public only while the athlete explicitly enables
    // their scout profile. Family and the primary squad owner retain access.
    match /players/{playerId}/thumbnails/{fileName} {
      allow read: if playerDocument(playerId).data.recruitingProfileEnabled == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeImageUpload();
      allow delete: if canManagePlayer(playerId);
    }

    match /players/{playerId}/avatar/{fileName} {
      allow read: if playerDocument(playerId).data.recruitingProfileEnabled == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeImageUpload();
      allow delete: if canManagePlayer(playerId);
    }

    match /players/{playerId}/videos/{fileName} {
      allow read: if playerDocument(playerId).data.recruitingProfileEnabled == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeVideoUpload();
      allow delete: if canManagePlayer(playerId);
    }

    // Only explicitly branded team assets are public.
    match /teams/{teamId}/branding/{allPaths=**} {
      allow read: if true;
      allow create, update: if (
        isSuperAdmin() ||
        (
          isSignedIn() &&
          firestore.get(/databases/(default)/documents/teams/$(teamId))
            .data.ownerUserId == request.auth.uid
        )
      ) && hasSafeImageUpload();
      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        firestore.get(/databases/(default)/documents/teams/$(teamId))
          .data.ownerUserId == request.auth.uid
      );
    }

    match /users/{userId}/avatar.jpg {
      allow read: if isSignedIn();
      allow create, update: if (
        isSuperAdmin() || (isSignedIn() && request.auth.uid == userId)
      ) && hasSafeImageUpload();
      allow delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // No implicit public bucket. Every supported asset path is declared above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
