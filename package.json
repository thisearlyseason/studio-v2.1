{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --quiet",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-squad-rules \"/usr/local/bin/node --test tests/firestore-rules.rules.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-squad-storage-rules \"/usr/local/bin/node --test tests/storage-rules.rules.mjs\""
  },
