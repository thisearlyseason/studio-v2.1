  "scripts": {
    "dev": "next dev -p 9001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:components",
    "test:node": "node --import tsx --test tests/*.test.mjs",
    "test:components": "vitest run",
    "test:rules": "firebase --project demo-the-squad-rules-test emulators:exec --only firestore,storage \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "verify:env": "node scripts/check-production-env.mjs",
    "qa:fixtures:preflight": "node scripts/qa-fixtures/cli.mjs preflight",
    "qa:fixtures:seed": "node scripts/qa-fixtures/cli.mjs seed",
    "qa:fixtures:inspect": "node scripts/qa-fixtures/cli.mjs inspect",
    "qa:fixtures:cleanup": "node scripts/qa-fixtures/cli.mjs cleanup",
    "qa:evidence:phase9": "node scripts/qa-evidence/phase9/cli.mjs",
    "qa:evidence:phase9:help": "node scripts/qa-evidence/phase9/cli.mjs help",
    "qa:evidence:phase9:recover-terminal": "node scripts/qa-evidence/phase9/cli.mjs recover-terminal",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run build && npm --prefix functions run build"
  },
